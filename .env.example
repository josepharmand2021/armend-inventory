# Copy this file to .env.local (Vite reads it automatically, and Vercel
# reads the same two names from its own Environment Variables settings —
# see SETUP.md). Both values are safe to expose in the browser: they only
# let the app talk to YOUR Supabase project, and every table is still
# protected by the row-level security policies in supabase/schema.sql.

# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings -> API -> Project API keys -> anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
